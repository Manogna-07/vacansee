# Copy this file to .env in the project root, then replace both placeholders.
# Restart the Vite dev server after changing .env.
# Required for authentication, database-backed jobs, applications, and saved jobs
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: MyMemory contact/quota parameter. Do not put paid API secrets in Vite variables.
VITE_TRANSLATE_EMAIL=you@example.com
